# VC Info Agent — 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# YouTube Data API v3 Key（可选，不填则跳过 YouTube 采集）
# 获取方式：https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# LLM API Key（必填，默认使用 DeepSeek）
# 获取方式：https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 飞书 Webhook（可选，不填则只输出 Markdown 文件）
# 创建方式：飞书群 → 设置 → 群机器人 → 自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK=

# Twitter/X API Bearer Token（可选，不填则跳过 Twitter 采集）
# 获取方式：https://developer.twitter.com → Create App → Bearer Token
TWITTER_BEARER_TOKEN=

# TikHub API Key（可选，不填则跳过微信公众号采集）
# 获取方式：https://tikhub.io → API 设置
TIKHUB_API_KEY=

# 反馈服务地址（可选，用于飞书卡片按钮跳转）
# 部署 feedback_server.py 后填入公网地址
FEEDBACK_BASE_URL=http://localhost:9002

# H5 服务公网地址（可选，用于详情页 / 音频 / 卡片图的公开 URL）
# 例: https://vcbrief.site
H5_BASE_URL=

# 微信桌面客户端推送（可选，仅 Windows + 已登录 WeChat）
# 设置目标聊天/联系人名称后启用 wxauto 自动发送
WECHAT_CHAT_NAME=

# 企业微信群机器人 Webhook（可选，云端可用，无需 GUI）
# 创建方式：企业微信群 → 群设置 → 群机器人 → 添加机器人 → 复制 Webhook 地址
# 注意：news 卡片需要 H5_BASE_URL 提供公网图片 URL；未配置时降级为 markdown 文本
WECOM_WEBHOOK_URL=
